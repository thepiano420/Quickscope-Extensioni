{
  "manifest_version": 3,
  "name": "QuickScope - Dark Pattern Detector",
  "version": "2.0.1",
  "description": "Detects and highlights manipulative design patterns on websites.",

  "permissions": [
    "activeTab",
    "storage",
    "notifications"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "QuickScope"
  }
}
